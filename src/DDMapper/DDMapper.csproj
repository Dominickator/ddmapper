<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DDMapper</AssemblyName>
    <RootNamespace>AutoMapper</RootNamespace>
    <PackageId>DDMapper</PackageId>
    <Version>0.1.0</Version>
    <Authors>DDMapper contributors</Authors>
    <Description>An original, from-scratch object-object mapper for .NET. Configuration, compiled execution plans, and a fallback conversion chain.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>
</Project>
